# =============================================================================
# Copie este arquivo para `.env` e preencha os valores.
# O arquivo `.env` NUNCA deve ser enviado ao GitHub (ja esta no .gitignore).
# Na hospedagem, cadastre cada linha no painel de variaveis de ambiente.
# =============================================================================

# --- Telegram ----------------------------------------------------------------
# Token que o @BotFather envia ao criar o bot.
BOT_TOKEN=

# ID do grupo principal da comunidade (numero negativo).
# Para descobrir: adicione o bot ao grupo e envie /id la dentro.
MAIN_GROUP_ID=

# ID do grupo restrito onde ficam os administradores (numero negativo).
ADMIN_GROUP_ID=

# --- Google Planilhas --------------------------------------------------------
# ID ou URL completa da planilha.
SPREADSHEET_ID=

# Nome da aba usada pelo bot. Se nao existir, o bot cria sozinho.
WORKSHEET_NAME=Solicitações Telegram

# Credenciais da conta de servico. Use UMA das duas formas:
#
#  (a) HOSPEDAGEM — cole o conteudo inteiro do arquivo .json em uma linha so:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
#
#  (b) LOCAL — caminho do arquivo baixado do Google Cloud:
GOOGLE_CREDENTIALS_FILE=credentials.json

# --- Hospedagem --------------------------------------------------------------
# Deixe VAZIO para rodar em modo polling na sua maquina (desenvolvimento).
#
# No Render, nao preencha: a plataforma define RENDER_EXTERNAL_URL sozinha.
# Em outras hospedagens, informe a URL publica do servico, sem barra no fim.
WEBHOOK_URL=

# Senha aleatoria que o Telegram devolve em cada chamada, provando que a
# requisicao veio mesmo dele. Gere qualquer texto longo e aleatorio.
WEBHOOK_SECRET=

# Porta HTTP. A maioria das hospedagens define isso automaticamente.
PORT=8080

# --- Outros ------------------------------------------------------------------
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
